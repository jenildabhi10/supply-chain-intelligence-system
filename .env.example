# ─── NASA FIRMS ───────────────────────────────────────────────────────────────
# Free registration: https://firms.modaps.eosdis.nasa.gov/api/
# Without this key, fire detection ingestion is skipped gracefully.
NASA_FIRMS_MAP_KEY=

# ─── Groq API (FREE) ──────────────────────────────────────────────────────────
# Free tier: 30 req/min, 14 400 calls/day — enough for a demo system.
# Register at: https://console.groq.com
GROQ_API_KEY=

# ─── Anthropic Claude (optional premium LLM) ──────────────────────────────────
# Used only if GROQ_API_KEY is not set, or for higher-quality explanations.
ANTHROPIC_API_KEY=

# ─── OpenWeather (optional — global coverage) ─────────────────────────────────
# Free tier: 1 000 calls/day. NWS is used for US ports without a key.
# Register at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=data
DB_PATH=data/supply_chain.duckdb
LOG_LEVEL=INFO

# ─── Ingestion tuning ─────────────────────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=30
EARTHQUAKE_MIN_MAGNITUDE=4.5
PORT_HAZARD_RADIUS_KM=200
NEWS_PROXIMITY_RADIUS_KM=500
